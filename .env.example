# Yahoo Developer Network application credentials.
# Create at https://developer.yahoo.com/apps/ with Fantasy Sports read/write.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=oob

# Where the pick list lives. Either a local path or a published-CSV URL.
PICKS_SOURCE=picks.csv

# League keys, comma separated. Format: {game_id}.l.{league_id}
# Find yours with: python -m waiver_window.leagues
LEAGUE_KEYS=

# Polling behaviour
POLL_INTERVAL_MS=250
POLL_START_LEAD_MIN=2
MAX_REQUESTS_PER_RUN=4000

# Optional push notification (ntfy.sh topic). Leave blank to log only.
NTFY_TOPIC=
